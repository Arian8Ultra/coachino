model UserProfile {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  params    UserProfileParam[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model UserProfileParam {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  key           String
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Subscription {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  options           SubscriptionOptionEnum[] // JSON array of options
  duration          Int // Duration in days
  chatsPerMonth     Int // Number of chats allowed per month
  tasksPerMonth     Int // Number of tasks allowed per month
  scenariosPerMonth Int // Number of scenarios allowed per month
  price             Float // Price of the subscription
  iconName          String?
  backgroundUrl     String?
  level             Int // Subscription level
  isFree            Boolean                  @default(false)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  UserSubscriptions UserSubscription[]
  Transactions      Transaction[]
}

enum SubscriptionOptionEnum {
  VIDEO_SEARCH
  SOURCE_PROVIDED
  ADVANCED_ANALYSIS
  AUTOMATIC_RESCHEDULING
}

model UserSubscription {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  startDate      DateTime     @default(now())
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Transaction {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Float
  transactionId  String       @unique
  status         String // e.g., "pending", "completed", "failed"
  zibalStatus    String? // e.g., "1" for success from Zibal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  urls        String[]
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Users       User[]
}

model NewUserOTP {
  phone      String    @unique
  otp        String?
  otp_expire DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PasswordReset {
  id         String    @id @default(cuid())
  phone      String    @unique
  otp        String?
  otp_expire DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expires   DateTime
  token     String   @unique
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean   @default(false)
  dueDate     DateTime?
  hasReminder Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Exam {
  id             String           @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userPrompt     String?
  systemPrompt   String?
  useForChat     Boolean          @default(false)
  Questions      Question[]
  UserExamResult UserExamResult[]
  Scenario       Scenario[]
  Dimension      Dimension[]
}

model Scale {
  id        String     @id @default(cuid())
  name      String     @unique // e.g. "Likert5_A_vs_B_FA"
  labels    String[] // نمایش گزینه‌ها (به ترتیب)
  weights   Int[] // وزن متناظر هر گزینه
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
}

model Dimension {
  id                     String                   @id @default(cuid())
  examId                 String
  exam                   Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  code                   String // مثل "E", "I", یا "O" در BigFive
  name                   String // نام نمایشی فارسی
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  QuestionKey            QuestionKey[]
  UserExamDimensionScore UserExamDimensionScore[]

  @@unique([examId, code])
}

model QuestionKey {
  id                 String    @id @default(cuid())
  questionId         String
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dimensionId        String
  dimension          Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  multiplier         Int // +1 معمولی، -1 برگشتی (reverse)
  perOptionWeights   Int[]
  keyedOptionIndexes Int[]
}

model Question {
  id            String        @id @default(cuid())
  examId        String
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  code          String? // کد داخلی سؤال (E01, Q12, ...)
  question      String // متن سؤال
  options       String[] // متن گزینه‌ها (نمایشی)
  type          QuestionType
  isMandatory   Boolean       @default(false)
  scaleId       String?
  scale         Scale?        @relation(fields: [scaleId], references: [id])
  optionWeights Int[]
  meta          Json?
  anchorA       String?
  anchorB       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  UserAnswers   UserAnswer[]
  QuestionKey   QuestionKey[]

  @@unique([examId, code])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  DATE
  FiveOption
}

enum NotificationType {
  SLIDER
  INPUT
  SELECT
  CHECKBOX
  RADIO
  TEXTAREA
  DATE
}

model UserAnswer {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserExamResult {
  id                     String                   @id @default(cuid())
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId                 String
  exam                   Exam                     @relation(fields: [examId], references: [id])
  // Legacy display fields you already had
  result                 String // e.g. title/type for UI (“INTP”, “High Grit”)
  score                  String // e.g. a quick numeric or short summary (“78/100”)
  description            String?
  details                String? // keep if you already use it
  color                  String?
  totalAnswered          Int                      @default(0)
  perDimension           Json? // map: code -> { raw, maxAbs, pct }
  resultJson             Json? // the full ScoreResult (safe to store)
  mbtiSimple             Json? // optional: {E:80,I:20,...} for MBTI-like exams
  typeLetters            String? // optional: “INTP”, “XSTJ”, etc.
  examVersion            String? // if you version exams/scales/items
  calcAt                 DateTime                 @default(now())
  durationMs             Int? // optional: client sends elapsed time
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Chats                  Chat[]
  RecommendedScenario    RecommendedScenario[]
  Scenario               Scenario[]
  UserExamDimensionScore UserExamDimensionScore[]
}

model UserExamDimensionScore {
  id               String         @id @default(cuid())
  userExamResultId String
  userExamResult   UserExamResult @relation(fields: [userExamResultId], references: [id])
  dimensionId      String?
  dimension        Dimension?     @relation(fields: [dimensionId], references: [id])
  code             String // e.g., "E", "I", "O", "C", ...
  name             String // Persian name snapshot
  raw              Float
  maxAbs           Float
  pct              Int
  rank             Int? // optional: 1..N ordering
  createdAt        DateTime       @default(now())

  @@index([userExamResultId])
  @@index([code])
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  function  String?
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id                 String       @id @default(cuid())
  chatId             String
  chat               Chat         @relation(fields: [chatId], references: [id])
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String       @default("user") // e.g., "user", "assistant", "system"
  url                String?
  type               String       @default("text") // e.g., "text", "image", "video", "link"
  expectedAnswers    String[]
  expectedAnswerType String? // e.g., "text", "number", "date"
  linkTitle          String? // Text for the link if type is "link"
  metaData           Json?
  content            String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  resultId           String?      @unique
  Attachments        Attachment[]
}

enum AnswerType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TEXT
  NUMBER
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  url       String?
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chat {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  model               MODEL? // e.g., "gpt-3.5-turbo", "gpt-4"
  Messages            Message[]
  Project             Project?              @relation(fields: [projectId], references: [id])
  projectId           String?
  userExamResultId    String? // Reference to UserExamResult
  UserExamResult      UserExamResult?       @relation(fields: [userExamResultId], references: [id])
  isMain              Boolean               @default(false)
  UserTasks           UserTask[]
  Scenario            Scenario[]
  RecommendedScenario RecommendedScenario[]
}

model UserTask {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(PENDING) // e.g., "pending", "in-progress",completed"
  priority    TaskPriority @default(NORMAL) // e.g., "low", "normal", "high"
  difficulty  Int? // Difficulty level of the task (1-5)
  isDelayed   Boolean      @default(false)
  isUpdated   Boolean      @default(false)
  startDate   DateTime     @default(now())
  dueDate     DateTime
  chatId      String?
  chat        Chat?        @relation(fields: [chatId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Scenario    Scenario?    @relation(fields: [scenarioId], references: [id])
  scenarioId  String?
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum MODEL {
  GPT_4_O
  O3
  O1
  GEMINI_2_FLASH
  CLAUDE_3_7_SONNET
}

model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  Chats     Chat[]
}

model Scenario {
  id              String          @id @default(cuid())
  name            String
  description     String?
  details         String?
  approximateTime Int? // Estimated time to complete the scenario in days
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId          String?
  exam            Exam?           @relation(fields: [examId], references: [id])
  examResultId    String?
  examResult      UserExamResult? @relation(fields: [examResultId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  Tasks           UserTask[]
  chatId          String?
  chat            Chat?           @relation(fields: [chatId], references: [id])
}

model RecommendedScenario {
  id               String          @id @default(cuid())
  name             String
  description      String?
  details          String?
  approximateTime  Int? // Estimated time to complete the scenario in days
  chosenByCoachino Boolean         @default(false)
  chosenByUser     Boolean         @default(false)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examResultId     String?
  examResult       UserExamResult? @relation(fields: [examResultId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  chatId           String?
  chat             Chat?           @relation(fields: [chatId], references: [id])
}
